{
  "name": "hariom-builds",
  "version": "2.6.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4028",
    "build": "npm run build:cloudflare",
    "build:next": "next build",
    "build:cloudflare": "npm install esbuild@0.28.2 --no-save --package-lock=false --legacy-peer-deps && npx @opennextjs/cloudflare@1.19.9 build",
    "start": "next dev -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "deploy": "npm install esbuild@0.28.2 --no-save --package-lock=false --legacy-peer-deps && npx @opennextjs/cloudflare@1.19.9 build && npx @opennextjs/cloudflare@1.19.9 deploy"
  },
  "dependencies": {
    "@dhiwise/component-tagger": "^1.0.16",
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "2.1.1",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.7",
    "lenis": "1.1.18",
    "lucide-react": "1.48.0",
    "next": "15.5.18",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "recharts": "^2.15.2",
    "autoprefixer": "10.4.2",
    "postcss": "8.4.8",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.6",
    "three": "0.186.1",
    "@opennextjs/cloudflare": "1.19.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wrangler": "4.140.0"
  }
}
